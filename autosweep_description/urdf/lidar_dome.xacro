<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lidar_dome" params="name parent xyz rpy topic">

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${name}_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>

    <!-- Keep the LiDAR as a distinct Gazebo link instead of lumping it into
         its parent. This preserves the sensor / visual association. -->
    <gazebo reference="${name}_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${name}_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />

        <geometry>
          <mesh
            filename="file://$(find autosweep_description)/meshes/Depth-Cameras/JT128-physical.stl"
            scale="0.001 0.001 0.001" />
        </geometry>

        <material name="${name}_dark">
          <color rgba="0.05 0.05 0.05 1" />
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.036525" rpy="0 0 0" />

        <geometry>
          <cylinder radius="0.035025" length="0.07305" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.036525" rpy="0 0 0" />

        <mass value="0.265" />

        <inertia
          ixx="1.8e-4" ixy="0" ixz="0"
          iyy="1.8e-4" iyz="0"
          izz="1.3e-4" />
      </inertial>

    </link>

    <gazebo reference="${name}_link">
      <!-- The official JT128 STL is a closed, opaque shell. Keep it visible
           in Gazebo, but exclude it from the GPU LiDAR render pass. -->
      <visual>
        <visibility_flags>0x02</visibility_flags>
      </visual>

      <sensor name="${name}" type="gpu_lidar">

        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <always_on>1</always_on>

        <topic>${topic}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <update_rate>10</update_rate>

        <lidar>
          <scan>
            <horizontal>
              <samples>900</samples>
              <resolution>1.0</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.28318530718</max_angle>
            </horizontal>
            <vertical>
              <samples>128</samples>
              <resolution>1.0</resolution>
              <min_angle>-0.0767944871</min_angle>
              <max_angle>1.579522973</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.05</min>
            <max>60.0</max>
            <resolution>0.02</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.03</stddev> <!-- lidar accuracy is +/-3cm -->
          </noise>

          <!-- World visuals use the default flags and remain detectable;
               the JT128 visual uses 0x02, so 0x01 & 0x02 == 0. -->
          <visibility_mask>0x01</visibility_mask>

          <frame_id>${name}_link</frame_id>
        </lidar>

      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
