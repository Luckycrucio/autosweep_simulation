<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="depth_camera" params="name parent xyz rpy topic">

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${name}_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="-0.026 0 0" rpy="1.5707 0 1.5707"/>
        <geometry>
          <mesh
            filename="file://$(find autosweep_description)/meshes/Depth-Cameras/D456_Solid.stl"
            scale="0.001 0.001 0.001" />
        </geometry>
      </visual>

      <collision>
        <origin xyz="-0.013 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.026 0.124 0.029"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="-0.013 0 0" rpy="0 0 0"/>
        <mass value="0.116" />
        <inertia ixx="1e-4" ixy="0" ixz="0"
          iyy="1e-4" iyz="0" izz="1e-4" />
      </inertial>
    </link>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate> <!-- frame rate, fps-->
        <topic>${topic}</topic>
        <camera>

          <horizontal_fov>1.518436449</horizontal_fov>

          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <!-- depth range-->
            <near>0.52</near>
            <far>6.0</far>
          </clip>

          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.002</stddev>
          </noise>

          <optical_frame_id>${name}_link_optical</optical_frame_id>

        </camera>

      </sensor>
      <sensor name="${name}_color" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>${topic}/color/image</topic>

        <camera>
          <horizontal_fov>1.570796327</horizontal_fov>

          <image>
            <width>1280</width>
            <height>800</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.01</near>
            <far>100.0</far>
          </clip>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>

          <optical_frame_id>${name}_link_optical</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>

    <!-- Solve ROS/optical frames conflict -->
    <link name="${name}_link_optical">
    </link>

    <joint type="fixed" name="${name}_optical_joint">
      <origin xyz="0 0 0" rpy="-1.5707 0 -1.5707" />
      <child link="${name}_link_optical" />
      <parent link="${name}_link" />
    </joint>

    <!-- Add IMU sensor -->
    <xacro:imu_sensor
      name="${name}"
      parent="${name}_link"
      topic="${topic}/imu" />

  </xacro:macro>

</robot>
